# Copy to .env and change every password before using outside local development.

POSTGRES_DB=hotel_pms
POSTGRES_PORT=5432
REDIS_PORT=6379

# Owner role: owns the schema, runs Alembic migrations. Bypasses RLS.
POSTGRES_OWNER_USER=pms_owner
POSTGRES_OWNER_PASSWORD=change-me-owner

# Runtime role: used by the API. Subject to RLS.
POSTGRES_APP_USER=pms_app
POSTGRES_APP_PASSWORD=change-me-app

# Backend settings (must match the values above).
DATABASE_URL=postgresql+asyncpg://pms_app:change-me-app@127.0.0.1:5432/hotel_pms
MIGRATION_DATABASE_URL=postgresql+asyncpg://pms_owner:change-me-owner@127.0.0.1:5432/hotel_pms
REDIS_URL=redis://127.0.0.1:6379/0
ENVIRONMENT=development

# Signs access tokens. At least 32 characters; generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-generate-a-random-secret-of-32-plus-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Local development only: lets outbound channel URLs use http and point at localhost.
# Never enable in production (the API refuses to start if you do).
CHANNEL_OUTBOUND_ALLOW_PRIVATE_HOSTS=true
